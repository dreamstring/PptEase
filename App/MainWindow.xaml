<Window x:Class="PptEase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PPT 增强" Width="1140" Height="790" MinWidth="940" MinHeight="660" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#4D5662"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="17,13"/><Setter Property="Margin" Value="10,3"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#F0F1F4"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FBEAE5"/><Setter Property="Foreground" Value="#B33E22"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#737D88"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="FontSize" Value="12"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#DFE3E9" BorderThickness="0,0,0,1">
            <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#D24726" Width="30" Height="30" CornerRadius="4" Margin="0,0,12,0"><TextBlock Text="P" Foreground="White" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PPT 增强" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="工作区" FontSize="12" Foreground="#8A929B" Margin="14,3,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#9AA3AD" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="尚未连接 PowerPoint" Foreground="#6C7681" FontSize="12" VerticalAlignment="Center"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="193"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#FAFBFC" BorderBrush="#E0E4E9" BorderThickness="0,0,1,0">
                <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="24,0,18,20"><TextBlock Text="PPT EASE" FontSize="10" FontWeight="SemiBold" Foreground="#9AA2AC"/><TextBlock Text="选择更轻松，创作更专注" FontSize="11" Foreground="#8B949E" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Margin="0,23,0,0"><TextBlock Text="增强工具" FontSize="11" Foreground="#8B949E" Margin="26,0,0,13"/><RadioButton x:Name="ObjectsNav" Content="对象与选择" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="True" Checked="ObjectsNav_Checked"/><RadioButton Content="材质预览" GroupName="Navigation" Style="{StaticResource NavItem}" Checked="ShaderNav_Checked"/><RadioButton Content="连接与诊断" GroupName="Navigation" Style="{StaticResource NavItem}" Checked="DiagnosticsNav_Checked"/></StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="30,25,30,22">
                <Grid x:Name="ObjectsPage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20"><TextBlock Text="对象与选择" Style="{StaticResource PageHeading}"/><TextBlock Text="管理当前幻灯片的对象锁定，减少误选与误操作。" Style="{StaticResource PageDescription}"/></StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,17" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前文稿" Style="{StaticResource StatusLabel}"/><TextBlock x:Name="PresentationLabel" Text="打开 PowerPoint 后点击刷新" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SlideLabel" Text="尚无活动幻灯片" Foreground="#7A8490" Margin="0,5,0,0" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="刷新对象" Click="Refresh_Click" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13,10" Margin="0,0,0,17">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PickColorButton" Content="智能取色" Click="PickColor_Click" IsEnabled="False" Padding="12,6" Margin="0,0,7,0"/><Button x:Name="ApplyColorButton" Visibility="Collapsed" Content="赋予颜色" Click="ApplyColor_Click" IsEnabled="False" Padding="12,6" Margin="0,0,7,0"/><Button x:Name="CancelColorButton" Visibility="Collapsed" Content="取消赋色" Click="CancelColor_Click" IsEnabled="False" Padding="12,6"/></StackPanel>
                            <TextBlock Grid.Column="1" Text="按 PPT 选区识别字体、填充或线条" Foreground="#7F8994" FontSize="11" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Background="White" BorderBrush="#DDE1E6" BorderThickness="1" CornerRadius="6">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
                            <Grid Margin="15,0"><TextBlock Text="幻灯片对象" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ObjectCountLabel" Text="0 个对象" Foreground="#7C8590" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                            <DataGrid Grid.Row="1" x:Name="ShapesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F3" BorderThickness="0" Background="White" RowHeaderWidth="0" SelectionChanged="ShapesGrid_SelectionChanged" EnableRowVirtualization="True">
                                <DataGrid.Columns><DataGridTextColumn Header="对象名称" Binding="{Binding Name}" Width="*" MinWidth="160"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="105"/><DataGridTemplateColumn Header="锁定" Width="86"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="未锁定"/><Setter Property="Foreground" Value="#7B8590"/><Style.Triggers><DataTrigger Binding="{Binding Locked}" Value="True"><Setter Property="Text" Value="已锁定"/><Setter Property="Foreground" Value="#BD492B"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="显示" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="可见"/><Setter Property="Foreground" Value="#67727E"/><Style.Triggers><DataTrigger Binding="{Binding Visible}" Value="False"><Setter Property="Text" Value="隐藏"/><Setter Property="Foreground" Value="#A1A8B1"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" BorderBrush="#E5E8ED" BorderThickness="0,1,0,0" Padding="15,0"><TextBlock x:Name="SelectionLabel" Text="按住 Ctrl 或 Shift 可多选对象" FontSize="12" Foreground="#84909B" VerticalAlignment="Center"/></Border>
                            <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="等待连接和对象数据" Foreground="#9099A3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="4" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="操作只作用于所选对象。" Foreground="#7F8994" FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LocateButton" Content="定位对象" Click="Select_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="UnlockButton" Content="解锁所选" Click="Unlock_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="LockButton" Content="锁定所选" Click="Lock_Click" IsEnabled="False" Style="{StaticResource AccentButton}"/></StackPanel></Grid>
                </Grid>
                <Grid x:Name="ShaderPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="材质预览" Style="{StaticResource PageHeading}"/><TextBlock Text="预览 GLSL ES / HLSL 材质，调整参数与时间。" Style="{StaticResource PageDescription}"/><TextBlock Text="独立预览后端；幻灯片原位与放映集成仍待验证。" Foreground="#A0644D" FontSize="12" Margin="0,7,0,0"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><ContentControl x:Name="ShaderHost" x:FieldModifier="public"><TextBlock Text="正在准备预览后端…" Foreground="#9099A3" HorizontalAlignment="Center" VerticalAlignment="Center"/></ContentControl></Border></Grid>
                <Grid x:Name="DiagnosticsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20"><TextBlock Text="连接与诊断" Style="{StaticResource PageHeading}"/><TextBlock Text="查看 PowerPoint 连接，管理右键增强的加载与恢复。" Style="{StaticResource PageDescription}"/></StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PowerPoint 版本" Style="{StaticResource StatusLabel}"/><TextBlock x:Name="HostVersionLabel" Text="未连接" FontSize="15" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="右键增强" Style="{StaticResource StatusLabel}"/><TextBlock x:Name="IntegrationLabel" Text="尚未加载" FontSize="15" FontWeight="SemiBold"/></StackPanel></Grid></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="宿主集成" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="启用后在 PowerPoint 中提供增强命令。禁用停止当前增强，卸载移除集成注册。" Style="{StaticResource PageDescription}" Margin="0,7,0,15"/><WrapPanel><Button Content="安装 / 启用增强" Click="Install_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/><Button Content="禁用增强" Click="Disable_Click" Margin="0,0,8,0"/><Button Content="还原 / 卸载" Click="Uninstall_Click"/></WrapPanel><TextBlock Text="在 PPT 增强选项卡右键命令，可加入快速访问工具栏。" Foreground="#7F8994" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0"/></StackPanel></Border>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="操作记录" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/><TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderThickness="0,1,0,0" BorderBrush="#E7EAEE" Padding="15,10" Background="#FBFCFD"/></Grid></Border>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#DFE3E9" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="就绪 · 尚未连接 PowerPoint" FontSize="11" Foreground="#808A95" VerticalAlignment="Center" Margin="17,0" TextTrimming="CharacterEllipsis"/></Border>
    </Grid>
</Window>
